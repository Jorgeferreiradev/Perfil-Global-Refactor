RewriteEngine On

# 1. SI EL ARCHIVO O CARPETA EXISTEN, ENTREGARLOS DIRECTAMENTE
# Si el archivo existe físicamente (-f), detenemos aquí las reglas ([L])
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Si la carpeta existe físicamente (-d), detenemos aquí
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. SI NO EXISTEN, ENVIAR AL ROUTER (index.php)
# Esta es la regla única para procesar URLs amigables
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

# --- CONFIGURACIÓN DE PHP (Mantenemos tus límites) ---
php_value upload_max_filesize 15M
php_value post_max_size 20M
php_value max_execution_time 300
php_value max_input_time 300